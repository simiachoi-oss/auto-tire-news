name: update-news
on:
  schedule:
    - cron: "0 21 * * *"   # 매일 한국 시간 오전 6시
  workflow_dispatch:        # 수동 실행 버튼
permissions:
  contents: write
jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: 뉴스 수집·요약
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: python3 collect.py
      - name: 결과 저장
        run: |
          git config user.name "news-bot"
          git config user.email "news-bot@users.noreply.github.com"
          git add news.json
          git diff --cached --quiet || (git commit -m "daily news update" && git push)
